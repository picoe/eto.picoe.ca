{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Build and serve site",
            "type": "debugpy",
            "request": "launch",
            "preLaunchTask": "Build site",
            "module": "http.server",
            "args": ["8080", "--bind", "127.0.0.1", "--directory", "public"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\(http://[^)]+\\)",
                "uriFormat": "http://localhost:8080/"
            }
        }
    ]
}
