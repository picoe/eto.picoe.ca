{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build site",
            "type": "shell",
            "command": "./build.sh",
            "options": {
                // Local Owl until a release has --site-header; remove to use .config/dotnet-tools.json.
                "env": {
                    "OWL_DIR": "${userHome}/Projects/McNeel/Owl"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Serve site",
            "type": "shell",
            // Runs the server outside VS Code so the task finishes; a still-running task is never restarted.
            "command": "pkill -f 'http.server 8080 --bind 127.0.0.1 --directory public'; nohup python3 -m http.server 8080 --bind 127.0.0.1 --directory public >/dev/null 2>&1 & sleep 1 && open http://localhost:8080/",
            "problemMatcher": []
        },
        {
            "label": "Stop site server",
            "type": "shell",
            "command": "pkill -f 'http.server 8080 --bind 127.0.0.1 --directory public' || true",
            "problemMatcher": []
        },
        {
            "label": "Build and serve site",
            "dependsOn": ["Build site", "Serve site"],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Hugo server (docs only)",
            "type": "shell",
            "command": "(sleep 2 && open http://localhost:1313/) & hugo server --disableFastRender",
            "isBackground": true,
            "problemMatcher": []
        }
    ]
}
