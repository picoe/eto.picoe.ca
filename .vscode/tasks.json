{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build site",
            "type": "shell",
            "command": "./build.sh",
            "options": {
                // Local Owl until a release has --site-header; remove to use .config/dotnet-tools.json.
                "env": {
                    "OWL_DIR": "${userHome}/Projects/McNeel/Owl"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Hugo server (docs only)",
            "type": "shell",
            "command": "(sleep 2 && open http://localhost:1313/) & hugo server --disableFastRender",
            "isBackground": true,
            "problemMatcher": []
        }
    ]
}
